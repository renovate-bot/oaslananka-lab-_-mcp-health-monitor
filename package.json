{
  "name": "mcp-health-monitor",
  "version": "1.0.5",
  "description": "MCP server for monitoring other MCP servers — track health, uptime, tool errors, response times, and Azure DevOps pipeline status",
  "type": "module",
  "main": "./dist/mcp.js",
  "types": "./dist/mcp.d.ts",
  "mcpName": "io.github.oaslananka/mcp-health-monitor",
  "bin": {
    "mcp-health-monitor": "dist/mcp.js"
  },
  "exports": {
    ".": {
      "import": "./dist/mcp.js",
      "types": "./dist/mcp.d.ts"
    },
    "./app": {
      "import": "./dist/app.js",
      "types": "./dist/app.d.ts"
    },
    "./checker": {
      "import": "./dist/checker.js",
      "types": "./dist/checker.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:clean": "npm run build",
    "start": "node dist/mcp.js",
    "start:http": "node dist/server-http.js",
    "dev": "node --loader ts-node/esm src/mcp.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:test": "eslint \"test/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=test[/\\\\]unit[/\\\\]",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=test[/\\\\]integration[/\\\\]",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "ci:check": "npm rebuild better-sqlite3 && npm run build && npm run typecheck && npm run lint && npm run lint:test && npm run format:check && npm test && npm run test:integration",
    "prepare": "npm run build",
    "prepublishOnly": "node scripts/prepublish-check.mjs"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "homepage": "https://github.com/oaslananka-lab/mcp-health-monitor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaslananka-lab/mcp-health-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/oaslananka-lab/mcp-health-monitor/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "monitoring",
    "health-check",
    "uptime",
    "azure-devops",
    "devops",
    "ai",
    "claude",
    "llm",
    "mcp-server",
    "sqlite",
    "observability"
  ],
  "author": "Osman Aslan <oaslananka@gmail.com>",
  "license": "MIT",
  "files": [
    "dist/",
    "mcp.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.10.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "jest": "30.4.2",
    "jest-util": "^30.4.1",
    "prettier": "3.8.3",
    "ts-jest": "^29.4.9",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}
